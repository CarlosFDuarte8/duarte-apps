# Copie para .env.local. Não sobrescreva seus contatos existentes.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Somente servidor. Nunca use prefixo NEXT_PUBLIC nesta chave.
SUPABASE_SERVICE_ROLE_KEY=SUBSTITUA_PELA_SERVICE_ROLE
# Somente para yarn db:migrate. Copie de Supabase > Connect > Session pooler.
# Use a senha do banco, não a service_role. Nunca compartilhe esta URL.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA_DO_BANCO@SEU_HOST_POOLER:5432/postgres
# Opcional: outra CA fornecida pelo projeto. A CA padrão do Supabase já está incluída.
# DATABASE_SSL_CA_FILE=C:/caminho/certificado.crt
CONTACT_WHATSAPP=
CONTACT_LINKEDIN=
CONTACT_GITHUB=
CONTACT_EMAIL=

# Web Push: server-only; generate VAPID keys once and keep the private key out of Git.
VOLEI_WEB_PUSH_ENABLED=false
VOLEI_WEB_PUSH_PUBLIC_KEY=
VOLEI_WEB_PUSH_PRIVATE_KEY=
VOLEI_WEB_PUSH_SUBJECT=https://duarte-apps.vercel.app
VOLEI_WEB_PUSH_CRON_SECRET=
